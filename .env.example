# =============================================================================
# CivicFix Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# Required for Database, Authentication, and Storage operations
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged service role key (Server-side ONLY - never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: PostgreSQL direct connection string for database migrations
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# AI Triage & Multimodal Evaluation (OpenRouter / Gemini)
# Required for automated multimodal hazard assessment & classification
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
